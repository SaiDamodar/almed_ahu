# Line ending configuration for ALMED AHU project

# Shell scripts should always use LF (Linux/Raspberry Pi)
*.sh text eol=lf

# Python scripts should always use LF  
*.py text eol=lf

# Service files should always use LF
*.service text eol=lf

# Arduino INO files should use LF
*.ino text eol=lf

# Documentation files
*.md text

# Flutter/Dart files
*.dart text
pubspec.yaml text
pubspec.lock text
analysis_options.yaml text

# Other text files
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.cpp text
*.h text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.otf binary
*.ttf binary
*.ico binary

