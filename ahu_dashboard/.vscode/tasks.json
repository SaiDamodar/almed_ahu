{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Reload Gradle Project",
            "type": "shell",
            "command": "cd ${workspaceFolder}/ahu_dashboard/android && ./gradlew --refresh-dependencies",
            "windows": {
                "command": "cd ${workspaceFolder}/ahu_dashboard/android && .\\gradlew.bat --refresh-dependencies"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
