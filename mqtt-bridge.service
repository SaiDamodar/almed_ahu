[Unit]
Description=MQTT Bridge: Raspberry Pi → HiveMQ Cloud
Documentation=https://www.hivemq.com/
After=network.target mosquitto.service
Wants=network.target mosquitto.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/almed/Documents/almed_ahu
ExecStart=/usr/bin/python3 /home/almed/Documents/almed_ahu/mqtt_bridge.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=false

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

